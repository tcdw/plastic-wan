{
  "name": "plasticwan",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "plasticwan": "./src/cli.ts"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "check": "tsc --noEmit && bun run --filter plasticwan-admin check",
    "test": "bun test",
    "start": "bun run src/cli.ts serve",
    "admin:dev": "bun run --filter plasticwan-admin dev",
    "admin:build": "bun run --filter plasticwan-admin build",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write ."
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.2",
    "@earendil-works/pi-ai": "0.84.2",
    "@inquirer/prompts": "^8.5.2",
    "@modelcontextprotocol/sdk": "1.30.0",
    "grammy": "1.45.1",
    "sharp": "0.35.3",
    "smol-toml": "^1.8.0",
    "typebox": "1.3.14",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@types/bun": "1.3.14",
    "typescript": "5.9.3"
  }
}
